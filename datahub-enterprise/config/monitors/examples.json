[
  {
    "name": "orders freshness (learned cadence)",
    "dataset_urn": "urn:li:dataset:(urn:li:dataPlatform:snowflake,analytics.public.orders,PROD)",
    "type": "freshness",
    "schedule": {"interval_seconds": 900},
    "config": {"source": "datahub"},
    "sensitivity": "medium",
    "severity": "HIGH"
  },
  {
    "name": "orders volume (seasonal anomaly + hard floor)",
    "dataset_urn": "urn:li:dataset:(urn:li:dataPlatform:snowflake,analytics.public.orders,PROD)",
    "type": "volume",
    "schedule": {"cron": "0 * * * *"},
    "config": {"source": "sql", "connection": "snowflake_prod", "min_rows": 1000, "seasonality": "hour_of_week"},
    "severity": "CRITICAL"
  },
  {
    "name": "customers.email null rate",
    "dataset_urn": "urn:li:dataset:(urn:li:dataPlatform:snowflake,analytics.public.customers,PROD)",
    "type": "field_metric",
    "schedule": {"interval_seconds": 3600},
    "config": {"source": "sql", "connection": "snowflake_prod", "field": "email", "metric": "null_pct", "max": 5}
  },
  {
    "name": "payments.method distribution drift",
    "dataset_urn": "urn:li:dataset:(urn:li:dataPlatform:snowflake,analytics.public.payments,PROD)",
    "type": "distribution",
    "schedule": {"cron": "15 3 * * *"},
    "config": {"source": "sql", "connection": "snowflake_prod", "field": "method", "kind": "categorical",
               "psi_warn": 0.1, "psi_fail": 0.25}
  }
