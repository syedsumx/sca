# Copy to .env and replace every CHANGE_ME. Generate secrets with:  openssl rand -hex 32
# ---------------------------------------------------------------- DataHub core
DATAHUB_VERSION=v1.8.0
DATAHUB_SYSTEM_CLIENT_SECRET=CHANGE_ME
DATAHUB_TOKEN_SERVICE_SIGNING_KEY=CHANGE_ME
DATAHUB_TOKEN_SERVICE_SALT=CHANGE_ME
DATAHUB_FRONTEND_SECRET=CHANGE_ME
MYSQL_PASSWORD=datahub
MYSQL_ROOT_PASSWORD=datahub
# Bootstrap admin used once by dhe-bootstrap to mint the DHE service PAT.
DATAHUB_BOOTSTRAP_USER=datahub
DATAHUB_BOOTSTRAP_PASSWORD=datahub

# ---------------------------------------------------------------- DHE control plane
DHE_VERSION=0.1.0
# Shared secret between GMS (authorizer plugin) and the DHE PDP / internal services.
DHE_SERVICE_TOKEN=CHANGE_ME
DHE_POSTGRES_PASSWORD=dhe

# Authorization mode:
#   additive       → DHE_NATIVE_POLICIES_ENABLED=true  (plugin only adds grants)
#   authoritative  → DHE_NATIVE_POLICIES_ENABLED=false (plugin is the only authorizer; deny-overrides)
DHE_AUTHZ_MODE=additive
DHE_NATIVE_POLICIES_ENABLED=true
DHE_VIEW_AUTHORIZATION_ENABLED=true

# ---------------------------------------------------------------- AI
# anthropic | ollama | none
DHE_LLM_PROVIDER=none
DHE_AI_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
DHE_OLLAMA_URL=http://ollama:11434
# hashing (offline, deterministic) | ollama   (datahub = native semantic search: roadmap M4.3)
DHE_EMBEDDING_PROVIDER=hashing

# ---------------------------------------------------------------- Remote agent demo
DHE_AGENT_POOL=finance
# Paste the one-time token returned by POST /agents/pools/finance/enrollment-tokens
DHE_AGENT_ENROLLMENT_TOKEN=

# ---------------------------------------------------------------- Host ports
DATAHUB_MAPPED_GMS_PORT=8080
DATAHUB_MAPPED_FRONTEND_PORT=9002
DHE_MAPPED_API_PORT=8800
DHE_MAPPED_MCP_PORT=8830
DHE_MAPPED_EDGE_PORT=9000
