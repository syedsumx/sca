# Copy to .env and replace every CHANGE_ME. Generate secrets with:  openssl rand -hex 32
# ---------------------------------------------------------------- DataHub core
DATAHUB_VERSION=v1.8.0
DATAHUB_SYSTEM_CLIENT_SECRET=CHANGE_ME
DATAHUB_TOKEN_SERVICE_SIGNING_KEY=CHANGE_ME
DATAHUB_TOKEN_SERVICE_SALT=CHANGE_ME
DATAHUB_FRONTEND_SECRET=CHANGE_ME
MYSQL_PASSWORD=datahub
MYSQL_ROOT_PASSWORD=datahub
# Bootstrap admin used once by aegis-bootstrap to mint the Aegis service PAT.
DATAHUB_BOOTSTRAP_USER=datahub
DATAHUB_BOOTSTRAP_PASSWORD=datahub

# ---------------------------------------------------------------- Aegis control plane
AEGIS_VERSION=0.1.0
# Shared secret between GMS (authorizer plugin) and the Aegis PDP / internal services.
AEGIS_SERVICE_TOKEN=CHANGE_ME
AEGIS_POSTGRES_PASSWORD=aegis

# Authorization mode:
#   additive       → AEGIS_NATIVE_POLICIES_ENABLED=true  (plugin only adds grants)
#   authoritative  → AEGIS_NATIVE_POLICIES_ENABLED=false (plugin is the only authorizer; deny-overrides)
AEGIS_AUTHZ_MODE=additive
AEGIS_NATIVE_POLICIES_ENABLED=true
AEGIS_VIEW_AUTHORIZATION_ENABLED=true

# ---------------------------------------------------------------- AI
# anthropic | ollama | none
AEGIS_LLM_PROVIDER=none
AEGIS_AI_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
AEGIS_OLLAMA_URL=http://ollama:11434
# hashing (offline, deterministic) | ollama   (datahub = native semantic search: roadmap M4.3)
AEGIS_EMBEDDING_PROVIDER=hashing

# ---------------------------------------------------------------- Active Metadata layer
# Public base URL users reach the edge on (used in Slack/Teams links and embed snippets).
AEGIS_PUBLIC_URL=http://localhost:9000
# HMAC secrets for one-click action links (Teams/email) and BI embed tokens. Required.
AEGIS_ACTION_LINK_SECRET=CHANGE_ME
AEGIS_EMBED_SIGNING_SECRET=CHANGE_ME
# Comma-separated origins allowed to frame embeds (CSP frame-ancestors), e.g.
#   https://acme.looker.com,https://*.online.tableau.com,https://app.powerbi.com
AEGIS_EMBED_ALLOWED_ORIGINS=
# Slack app (deploy/slack/app-manifest.yaml). Leave blank to disable Slack.
AEGIS_SLACK_BOT_TOKEN=
AEGIS_SLACK_SIGNING_SECRET=
# Default Microsoft Teams Workflows webhook (per-domain routes are configured in the UI).
AEGIS_TEAMS_WEBHOOK_URL=
# Optional SMTP relay for email digests, e.g. smtp://user:pass@smtp.example.com:587?starttls=true
AEGIS_SMTP_URL=

# ---------------------------------------------------------------- Remote agent demo
AEGIS_AGENT_POOL=finance
# Paste the one-time token returned by POST /agents/pools/finance/enrollment-tokens
AEGIS_AGENT_ENROLLMENT_TOKEN=

# ---------------------------------------------------------------- Host ports
DATAHUB_MAPPED_GMS_PORT=8080
DATAHUB_MAPPED_FRONTEND_PORT=9002
AEGIS_MAPPED_API_PORT=8800
AEGIS_MAPPED_MCP_PORT=8830
AEGIS_MAPPED_EDGE_PORT=9000
