# Postgres (with pgvector). docker compose overrides the host to "db".
TETHER_DATABASE_URL=postgresql+psycopg://tether:tether@localhost:5432/tether
# Database used by pytest (it is wiped on each run).
TETHER_TEST_DATABASE_URL=postgresql+psycopg://tether:tether@localhost:5432/tether_test
# Embedder: "fake" (deterministic, offline) or "sentence-transformers"
TETHER_EMBEDDER=fake
TETHER_EMBEDDING_DIM=384
TETHER_SENTENCE_TRANSFORMERS_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Run the deletion job worker inside the API process (handy for local dev)
TETHER_RUN_WORKER_IN_API=false
# Seconds to pause between deletion steps (makes the live status UI visible in demos)
TETHER_DELETION_STEP_DELAY=0
# Optional OpenLineage endpoint (e.g. Marquez: http://marquez:5000/api/v1/lineage)
TETHER_OPENLINEAGE_URL=
TETHER_OPENLINEAGE_NAMESPACE=tether-demo
# Comma separated origins allowed by CORS (the UI dev server)
TETHER_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
