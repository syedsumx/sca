# Copy to .env and replace every CHANGE_ME. Generate secrets with:  openssl rand -hex 32
# ---------------------------------------------------------------- Cairn Core
# Password of the built-in root account "admin" (web sign-in and service-token bootstrap).
CAIRN_ADMIN_PASSWORD=CHANGE_ME
CAIRN_SYSTEM_CLIENT_SECRET=CHANGE_ME
CAIRN_SESSION_SIGNING_KEY=CHANGE_ME
CAIRN_TOKEN_SALT=CHANGE_ME
CAIRN_WEB_SECRET=CHANGE_ME
CAIRN_DB_PASSWORD=CHANGE_ME
CAIRN_DB_ROOT_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------- Cairn control plane
CAIRN_VERSION=0.1.0
# Shared secret between Cairn Core (authorizer plugin) and the Cairn PDP / internal services.
CAIRN_SERVICE_TOKEN=CHANGE_ME
CAIRN_POSTGRES_PASSWORD=cairn

# Authorization mode:
#   additive       → CAIRN_NATIVE_POLICIES_ENABLED=true  (plugin only adds grants)
#   authoritative  → CAIRN_NATIVE_POLICIES_ENABLED=false (plugin is the only authorizer; deny-overrides)
CAIRN_AUTHZ_MODE=additive
CAIRN_NATIVE_POLICIES_ENABLED=true
CAIRN_VIEW_AUTHORIZATION_ENABLED=true

# ---------------------------------------------------------------- AI
# anthropic | ollama | none
CAIRN_LLM_PROVIDER=none
CAIRN_AI_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
CAIRN_OLLAMA_URL=http://ollama:11434
# hashing (offline, deterministic) | ollama   (native semantic search: roadmap M4.3)
CAIRN_EMBEDDING_PROVIDER=hashing

# ---------------------------------------------------------------- Active Metadata layer
# Public base URL users reach the edge on (used in Slack/Teams links and embed snippets).
CAIRN_PUBLIC_URL=http://localhost:9000
# HMAC secrets for one-click action links (Teams/email) and BI embed tokens. Required.
CAIRN_ACTION_LINK_SECRET=CHANGE_ME
CAIRN_EMBED_SIGNING_SECRET=CHANGE_ME
# Comma-separated origins allowed to frame embeds (CSP frame-ancestors), e.g.
#   https://acme.looker.com,https://*.online.tableau.com,https://app.powerbi.com
CAIRN_EMBED_ALLOWED_ORIGINS=
# Slack app (deploy/slack/app-manifest.yaml). Leave blank to disable Slack.
CAIRN_SLACK_BOT_TOKEN=
CAIRN_SLACK_SIGNING_SECRET=
# Default Microsoft Teams Workflows webhook (per-domain routes are configured in the UI).
CAIRN_TEAMS_WEBHOOK_URL=
# Optional SMTP relay for email digests, e.g. smtp://user:pass@smtp.example.com:587?starttls=true
CAIRN_SMTP_URL=

# ---------------------------------------------------------------- Remote agent demo
CAIRN_AGENT_POOL=finance
# Paste the one-time token returned by POST /agents/pools/finance/enrollment-tokens
CAIRN_AGENT_ENROLLMENT_TOKEN=

# ---------------------------------------------------------------- Host ports
# Loopback-only operator ports (users go through the edge)
CAIRN_MAPPED_CORE_PORT=8080
CAIRN_MAPPED_WEB_PORT=9002
CAIRN_MAPPED_API_PORT=8800
CAIRN_MAPPED_MCP_PORT=8830
CAIRN_MAPPED_EDGE_PORT=9000

# ---------------------------------------------------------------- Service token rotation
CAIRN_TOKEN_ROTATE_DAYS=7
CAIRN_TOKEN_GRACE_MINUTES=15
