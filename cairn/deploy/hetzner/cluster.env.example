# Cairn on Hetzner: settings for deploy/hetzner/cluster.sh. Copy it OUTSIDE the repository
# (it holds secrets), fill it in, and chmod 600 it.
CLUSTER_NAME=cairn

# The dedicated servers: "name public-IPv4 vSwitch-IP". Three for a highly available control plane
# (etcd needs a majority); add more lines for more capacity. The first is where the cluster starts.
NODES=(
  "cairn-1 203.0.113.11 10.10.0.11"
  "cairn-2 203.0.113.12 10.10.0.12"
  "cairn-3 203.0.113.13 10.10.0.13"
)
VLAN_ID=4000                 # the vSwitch's VLAN (robot.sh vswitch-create)
PRIVATE_PREFIX=24
SSH_USER=root
# SSH_KEY=~/.ssh/id_ed25519

# Where you run ssh and kubectl from (your office or VPN egress). Never 0.0.0.0/0.
ADMIN_CIDRS="198.51.100.7/32"
# The load balancer's public IPv4 (terraform output lb_ipv4), as /32. Until it is set, the ingress is closed.
LB_SOURCE_CIDRS=""
# A DNS name for the Kubernetes API (optional; otherwise the first node's address).
# API_HOST=k8s.cairn.example.cloud

K3S_VERSION=v1.33.3+k3s1

# Hetzner Object Storage (Cloud Console -> Object Storage -> credentials): etcd snapshots, PostgreSQL
# backups. Location fsn1, nbg1 or hel1. Leave the keys empty only for a throwaway test cluster.
OBJECT_STORAGE_ENDPOINT=https://fsn1.your-objectstorage.com
OBJECT_STORAGE_REGION=fsn1
OBJECT_STORAGE_ACCESS_KEY=""
OBJECT_STORAGE_SECRET_KEY=""
BUCKET_PREFIX=cairn-prod-example   # bucket names are global: make it yours

# Shared services (platform.sh)
ACME_EMAIL=ops@example.cloud       # Let's Encrypt account: expiry warnings go here
PG_INSTANCES=3
PG_STORAGE=200Gi
PG_MEMORY=4Gi
PG_CPU=1
MONITORING=true

# Tenants (deploy/hosting/tenant.sh): export these, then
#   deploy/hosting/tenant.sh create acme --licence acme.licence --values deploy/hetzner/platform-values.yaml
export CAIRN_HOST_DOMAIN=cairn.example.cloud   # *.cairn.example.cloud -> the load balancer (DNS A record)
export CAIRN_PG_HOST=cairn-pg-rw.cairn-platform.svc
export CAIRN_PG_KUBECTL=cairn-platform/cairn-pg
export CAIRN_TENANT_SERVICES=1
export CAIRN_INGRESS_NAMESPACE=ingress-nginx
export CAIRN_MONITORING_NAMESPACE=monitoring
export CAIRN_TLS_ISSUER=letsencrypt
export CAIRN_POD_SECURITY=baseline
