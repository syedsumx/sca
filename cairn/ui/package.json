{
  "name": "@cairn/web-react-modules",
  "version": "0.1.0",
  "description": "Cairn UI modules for cairn-web-ui: data quality, governance, remote agents, AI discovery.",
  "license": "Apache-2.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:mfe": "webpack --config webpack.mfe.config.js --mode production",
    "build:embed": "node scripts/build-embed.mjs",
    "build": "npm run build:mfe && npm run build:embed",
    "build:demo": "node scripts/build-demo.mjs"
  },
  "peerDependencies": {
    "antd": "4.24.7",
    "react": "^17.0.0",
    "react-dom": "^17.0.0",
    "react-router-dom": "^5.3.0",
    "styled-components": "^5.2.1"
  },
  "devDependencies": {
    "@ant-design/icons": "4.8.3",
    "@testing-library/react": "12.1.5",
    "@types/node": "^18.19.39",
    "@types/react": "17.0.83",
    "@types/react-dom": "17.0.25",
    "@types/react-router-dom": "5.3.3",
    "@types/styled-components": "5.1.34",
    "antd": "4.24.7",
    "esbuild": "^0.24.2",
    "esbuild-loader": "^4.2.2",
    "jsdom": "24.1.3",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-router-dom": "5.3.4",
    "styled-components": "5.3.11",
    "typescript": "4.9.5",
    "vitest": "1.6.0",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4"
  }
}
