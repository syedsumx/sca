{
  "name": "@cairn/web-react-modules",
  "version": "0.1.0",
  "description": "Cairn UI modules for cairn-web-ui: data quality, governance, remote agents, AI discovery.",
  "license": "Apache-2.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:mfe": "webpack --config webpack.mfe.config.js --mode production",
    "build:embed": "node scripts/build-embed.mjs",
    "build": "npm run build:mfe && npm run build:embed && npm run build:docs",
    "build:demo": "node scripts/build-demo.mjs",
    "build:fleet": "node scripts/build-fleet.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "build:help": "node scripts/build-help.mjs",
    "build:site": "node scripts/build-demo.mjs && node scripts/build-docs.mjs ../docs/site dist/site/docs && cp dist/demo/index.html dist/site/index.html && node scripts/build-fleet.mjs && mkdir -p dist/site/fleet && cp dist/fleet-demo/index.html dist/site/fleet/index.html"
  },
  "peerDependencies": {
    "antd": "4.24.7",
    "react": "^17.0.0",
    "react-dom": "^17.0.0",
    "react-router-dom": "^5.3.0",
    "styled-components": "^5.2.1"
  },
  "devDependencies": {
    "@ant-design/icons": "4.8.3",
    "@testing-library/react": "12.1.5",
    "@types/node": "^18.19.39",
    "@types/react": "17.0.83",
    "@types/react-dom": "17.0.25",
    "@types/react-router-dom": "5.3.3",
    "@types/styled-components": "5.1.34",
    "antd": "4.24.7",
    "axe-core": "4.10.3",
    "esbuild": "^0.24.2",
    "esbuild-loader": "^4.2.2",
    "jsdom": "24.1.3",
    "marked": "^14.1.4",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-router-dom": "5.3.4",
    "styled-components": "5.3.11",
    "typescript": "4.9.5",
    "vitest": "1.6.0",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "sql-formatter": "15.9.0"
  }
}
