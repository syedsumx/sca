{
  "id": "./app.html",
  "name": "Cairn",
  "short_name": "Cairn",
  "description": "Find, query and trust your data, governed: the Cairn workspace.",
  "start_url": "./app.html#/discover",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#1f40a6",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Search", "url": "./app.html#/search", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Ask the assistant", "url": "./app.html#/assistant", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Your profile", "url": "./app.html#/profile", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
