<?xml version="1.0" encoding="utf-8"?>
<!--
  Tableau dashboard extension: shows Cairn Core trust signals (certification, quality, freshness,
  owners) for the data source behind a dashboard. Replace CAIRN_HOST with your Cairn Core origin and
  URN / TOKEN with the values from Cairn Core → Workspace → Settings → Embeds (one token per asset).
  Tableau requires https:// for extension URLs (http://localhost is allowed for testing).
-->
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="io.cairn.trust" extension-version="0.2.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Cairn Core trust card: certification, data quality, freshness and owners.</description>
    <author name="Cairn" email="data-platform@example.com" organization="Cairn" website="https://cairn.example.com"/>
    <min-api-version>1.4</min-api-version>
    <source-location>
      <url>https://CAIRN_HOST/cairn/api/embed/v1/frame/card?urn=URN&amp;token=TOKEN</url>
    </source-location>
    <icon></icon>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Cairn Core Trust</text>
    </resource>
  </resources>
</manifest>
